# ═══════════════════════════════════════════════════════════════════════════════
# VIGIL LABS - Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=VIGIL LABS
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # MUST be false in production

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
WORKERS=1                        # Set to (2 * CPU cores + 1) in production

# ─── Security (CRITICAL) ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-USE-ENV-VAR
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INACTIVITY_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ─── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./vigil_labs.db

# PostgreSQL (production - uncomment and configure):
# DATABASE_URL=postgresql+asyncpg://vigil:password@localhost:5432/vigil_labs
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                  # json (production) | text (development)
LOG_FILE=                        # Empty = stdout only; set path for file logging

# ─── Execution Engine ─────────────────────────────────────────────────────────
DEFAULT_TIMEOUT=300              # Default execution timeout (seconds)
MAX_TIMEOUT=3600                 # Maximum allowed timeout (1 hour)
MAX_CONCURRENT_PROCESSES=10
MAX_OUTPUT_SIZE=10000000         # 10MB max output per process

# ─── Command Security ─────────────────────────────────────────────────────────
# Allow shell operators (;, |, &&, etc.) in commands
# WARNING: Only enable in trusted environments
ALLOW_SHELL_OPERATORS=false

# ─── User Registration ────────────────────────────────────────────────────────
FIRST_USER_IS_ADMIN=true         # First registered user gets admin role
REGISTRATION_ENABLED=true        # Set false to prevent new signups
REQUIRE_EMAIL_VERIFICATION=false

# ─── AI Assistant ─────────────────────────────────────────────────────────────
AI_ENABLED=true
AI_MODEL=gemini                  # local = rule-based (no API) | gemini = Google Gemini AI

# Get free Gemini API key: https://aistudio.google.com/apikey (just Google login, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash   # fast + free (15 req/min)
