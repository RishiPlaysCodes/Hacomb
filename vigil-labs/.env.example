# ═══════════════════════════════════════════════════════════════════════════════
# VIGIL LABS - Docker Compose Environment
# Copy to .env before running: docker compose up
# ═══════════════════════════════════════════════════════════════════════════════

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Database (default: SQLite, for PostgreSQL see below)
DATABASE_URL=sqlite+aiosqlite:///./data/vigil_labs.db

# PostgreSQL (uncomment for production):
# DATABASE_URL=postgresql+asyncpg://vigil:${DB_PASSWORD}@postgres:5432/vigil_labs
# DB_USER=vigil
# DB_PASSWORD=
# DB_NAME=vigil_labs

# Server
WORKERS=2
LOG_LEVEL=INFO
MAX_CONCURRENT_PROCESSES=10
ACCESS_TOKEN_EXPIRE_MINUTES=30
REGISTRATION_ENABLED=true

# Frontend
FRONTEND_PORT=80
